<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
    <script>document.documentElement.classList.remove('no-js');</script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- Preconnect to third-party origins (performance + SEO) -->
    <link rel="dns-prefetch" href="https://www.googletagmanager.com">
    <!-- Google Analytics loads only after consent (see cookie-consent and script.js) -->
    <script>
      (function() {
        try {
          const stored = localStorage.getItem('ccn_consent');
          if (stored) {
            const prefs = JSON.parse(stored);
            if (prefs.analytics === true) {
              var s = document.createElement('script');
              s.async = true;
              s.src = 'https://www.googletagmanager.com/gtag/js?id=G-MDYV0G0D42';
              document.head.appendChild(s);
              window.dataLayer = window.dataLayer || [];
              function gtag(){dataLayer.push(arguments);}
              gtag('js', new Date());
              gtag('config', 'G-MDYV0G0D42');
            }
          }
        } catch (e) {}
      })();
    </script>

    <title>{% if title %}{{ title }} - {% endif %}Code Craft North</title>
    <meta name="description" content="{{ (description or excerpt or 'Hand-built, lightning-fast websites, backed by ongoing support and honest expertise. Professional web design services for small businesses.') | descriptionMeta }}">
    {% if keywords %}<meta name="keywords" content="{{ keywords }}">{% else %}<meta name="keywords" content="web design, website development, small business websites, UK web design, fast websites, SEO">{% endif %}
    <meta name="author" content="{% if isBlogPost %}Carl Ball{% else %}Code Craft North{% endif %}">
    
    <!-- Canonical URL -->
    <link rel="canonical" href="https://codecraftnorth.co.uk{{ page.url }}">
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="{% if isBlogPost %}article{% else %}website{% endif %}">
    <meta property="og:site_name" content="Code Craft North">
    <meta property="og:locale" content="en_GB">
    <meta property="og:url" content="https://codecraftnorth.co.uk{{ page.url }}">
    <meta property="og:title" content="{% if title %}{{ title }}{% if not isBlogPost %} - {% endif %}{% endif %}{% if not isBlogPost %}Code Craft North{% endif %}">
    <meta property="og:description" content="{{ (description or excerpt or 'Hand-built, lightning-fast websites, backed by ongoing support and honest expertise.') | descriptionMeta }}">
    <meta property="og:image" content="{% if image %}https://codecraftnorth.co.uk{{ image }}{% else %}https://codecraftnorth.co.uk/img/logos/CCN-logo-transparent-blue.webp{% endif %}">
    {% if isBlogPost and date %}
    <meta property="article:published_time" content="{{ date | htmlDateString }}">
    {% if dateModified or updated %}<meta property="article:modified_time" content="{{ (dateModified or updated) | htmlDateString }}">{% endif %}
    <meta property="article:author" content="Carl Ball">
    {% endif %}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="https://codecraftnorth.co.uk{{ page.url }}">
    <meta property="twitter:title" content="{% if title %}{{ title }}{% if not isBlogPost %} - {% endif %}{% endif %}{% if not isBlogPost %}Code Craft North{% endif %}">
    <meta property="twitter:description" content="{{ (description or excerpt or 'Hand-built, lightning-fast websites, backed by ongoing support and honest expertise.') | descriptionMeta }}">
    <meta property="twitter:image" content="{% if image %}https://codecraftnorth.co.uk{{ image }}{% else %}https://codecraftnorth.co.uk/img/logos/CCN-logo-transparent-blue.webp{% endif %}">
    {% if robots %}
    <meta name="robots" content="{{ robots }}">
    {% endif %}

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/img/logos/favicon-transparent.png">
    <link rel="apple-touch-icon" href="/img/logos/favicon-transparent.png">
    <link rel="shortcut icon" href="/img/logos/favicon-transparent.png">
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Styles -->
    <link rel="stylesheet" href="/css/styles.css">
    
    <!-- Prevent flash of wrong theme -->
    <script>
        (function() {
            const savedTheme = localStorage.getItem('theme');
            const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            const theme = savedTheme || (prefersDark ? 'dark' : 'light');
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
</head>
    <body class="font-sans bg-bg-primary dark:bg-bg-primary-dark text-text-primary dark:text-text-strong-dark">
    {% include "header.njk" %}
    
    <main>
        {{ content | safe }}
    </main>
    
    {% include "footer.njk" %}
    {% include "cookie-consent.njk" %}

    <!-- Structured Data (Schema.org) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "CodeCraft North",
      "description": "Professional web design and development services for small businesses in the UK",
      "url": "https://codecraftnorth.co.uk",
      "email": "hello@codecraftnorth.co.uk",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Wirral",
        "addressRegion": "Merseyside",
        "addressCountry": "GB"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "53.3727",
        "longitude": "-3.0738"
      },
      "areaServed": {
        "@type": "Country",
        "name": "United Kingdom"
      },
      "priceRange": "££",
      "openingHours": "Mo-Fr 09:00-17:00",
      "sameAs": [
        "https://www.linkedin.com/company/codecraftnorth"
      ],
      "founder": {
        "@type": "Person",
        "name": "Carl Ball"
      }
    }
    </script>

    <!-- Scripts -->
    <script src="/js/script.js"></script>
</body>
</html>
