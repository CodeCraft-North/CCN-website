<div id="cookie-consent-banner" class="fixed bottom-0 left-0 right-0 z-50 hidden p-6 bg-bg-surface dark:bg-bg-surface-dark border-t border-border-standard dark:border-border-standard-dark shadow-[0_-4px_20px_rgba(0,0,0,0.1)] dark:shadow-[0_-4px_20px_rgba(0,0,0,0.3)]" role="dialog" aria-labelledby="cookie-consent-title" aria-describedby="cookie-consent-description">
    <div class="max-w-4xl mx-auto flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex-1">
            <h2 id="cookie-consent-title" class="text-lg font-bold text-text-primary dark:text-text-strong-dark mb-2">We use cookies</h2>
            <p id="cookie-consent-description" class="text-text-secondary dark:text-text-secondary-dark text-sm md:text-base">
                We use essential cookies to keep the site secure and analytics cookies to understand how visitors use the site. You can accept analytics or use essential cookies only.
                <a href="/cookie-policy/" class="text-brand-primary dark:text-brand-primary-on-dark hover:underline font-medium">Cookie policy</a>
            </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
            <button type="button" id="cookie-consent-accept" class="btn btn--primary px-6 py-3 min-h-[44px] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-primary">
                Accept analytics
            </button>
            <button type="button" id="cookie-consent-decline" class="btn btn--secondary px-6 py-3 min-h-[44px] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-primary">
                Essential only
            </button>
        </div>
    </div>
</div>
