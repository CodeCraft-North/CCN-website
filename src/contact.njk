---
layout: base.njk
title: "Talk through your website"
description: "Tell Carl at Code Craft North about your website project or arrange a short discovery call. Based in the Wirral and working with businesses across the UK."
date: 2026-08-14
---

<!-- Contact journey -->
<section class="contact-hero relative overflow-hidden bg-bg-primary dark:bg-bg-primary-dark">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
        <div class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-brand-light dark:bg-brand-dark/40 blur-3xl opacity-70" style="animation: var(--animate-drift);"></div>
        <div class="absolute -bottom-40 -right-20 w-md h-112 rounded-full bg-brand-primary/10 dark:bg-brand-primary-on-dark/10 blur-3xl" style="animation: var(--animate-drift-slow); animation-delay: -6s;"></div>
    </div>
    <div class="container relative z-10 py-16 md:py-24">
        <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-10 lg:gap-16 items-start">
            <div class="hero-entry lg:sticky lg:top-28">
                <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-brand-light dark:bg-brand-dark/50 text-brand-primary dark:text-brand-primary-on-dark text-sm font-semibold tracking-wide mb-6">
                    <span class="w-2 h-2 rounded-full bg-brand-primary"></span>
                    Start with a conversation
                </span>
                <h1 class="text-4xl sm:text-5xl md:text-6xl font-black mb-6 text-text-primary dark:text-text-strong-dark leading-[1.05]">Tell me what your website needs to <span class="text-brand-primary dark:text-brand-primary-on-dark">do better.</span></h1>
                <p class="text-xl font-semibold text-text-primary dark:text-text-strong-dark mb-5 leading-snug">You do not need a finished brief or all the answers.</p>
                <p class="text-lg text-text-secondary dark:text-text-secondary-dark leading-relaxed mb-8">Share where the business is now, what is not working and what you want to change. I will reply personally within one business day with a sensible next step.</p>

                <div class="contact-reassurance hidden lg:flex">
                    <div class="contact-reassurance__photo">
                        {% image "./src/img/Carl_Ball.webp", "Carl Ball from Code Craft North", [160, 240], "w-full h-full object-cover" %}
                    </div>
                    <div>
                        <p class="font-bold text-text-primary dark:text-text-strong-dark">Your message comes directly to me</p>
                        <p class="text-sm text-text-secondary dark:text-text-secondary-dark">Carl Ball, founder and developer</p>
                    </div>
                </div>

                <ul class="check-list hidden lg:grid mt-8 mb-0">
                    <li>No sales pressure</li>
                    <li>Wirral-based, working across the UK</li>
                    <li>Plain-English, practical advice</li>
                </ul>

                <p class="hidden lg:block mt-8 text-sm text-text-secondary dark:text-text-secondary-dark">Prefer email? <a href="mailto:hello@codecraftnorth.co.uk" class="text-link">hello@codecraftnorth.co.uk</a></p>
                <p class="hidden lg:block mt-3 text-sm text-text-secondary dark:text-text-secondary-dark">Only looking for a second opinion? <a href="/website-review/" class="text-link">Request a free website review</a>.</p>
            </div>

            <div class="reveal bg-bg-surface dark:bg-bg-surface-dark rounded-xl p-6 md:p-8 shadow-lg border border-border-standard dark:border-border-standard-dark">
                <p class="eyebrow">Project enquiry</p>
                <h2 class="text-3xl font-black mb-3 text-text-primary dark:text-text-strong-dark">A few details to get started</h2>
                <p class="text-text-secondary dark:text-text-secondary-dark mb-8 leading-relaxed">The more context you share, the more useful my first reply can be.</p>

                <form id="contact-form" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="space-y-6">
                    <input type="hidden" name="form-name" value="contact">
                    <p class="hidden">
                        <label>Don't fill this out if you're human: <input name="bot-field" maxlength="50" /></label>
                    </p>
                    <div>
                        <label for="name" class="block text-sm font-semibold text-text-primary dark:text-text-strong-dark mb-2">Name *</label>
                        <input 
                            type="text" 
                            id="name" 
                            name="name" 
                            required 
                            maxlength="100"
                            autocomplete="name"
                            class="w-full px-4 py-3 rounded-lg border border-border-standard dark:border-border-standard-dark bg-bg-surface dark:bg-bg-surface-dark text-text-primary dark:text-text-strong-dark focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 outline-none transition-all"
                            placeholder="Your name"
                        >
                    </div>

                    <div>
                        <label for="email" class="block text-sm font-semibold text-text-primary dark:text-text-strong-dark mb-2">Email *</label>
                        <input 
                            type="email" 
                            id="email" 
                            name="email" 
                            required 
                            maxlength="254"
                            autocomplete="email"
                            class="w-full px-4 py-3 rounded-lg border border-border-standard dark:border-border-standard-dark bg-bg-surface dark:bg-bg-surface-dark text-text-primary dark:text-text-strong-dark focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 outline-none transition-all"
                            placeholder="your@email.com"
                        >
                    </div>

                    <div>
                        <label for="phone" class="block text-sm font-semibold text-text-primary dark:text-text-strong-dark mb-2">Phone (optional)</label>
                        <input 
                            type="tel" 
                            id="phone" 
                            name="phone" 
                            maxlength="20"
                            autocomplete="tel"
                            class="w-full px-4 py-3 rounded-lg border border-border-standard dark:border-border-standard-dark bg-bg-surface dark:bg-bg-surface-dark text-text-primary dark:text-text-strong-dark focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 outline-none transition-all"
                            placeholder="Your phone number"
                        >
                    </div>

                    <div>
                        <label for="business" class="block text-sm font-semibold text-text-primary dark:text-text-strong-dark mb-2">Business or organisation name (optional)</label>
                        <input 
                            type="text" 
                            id="business" 
                            name="business" 
                            maxlength="100"
                            autocomplete="organization"
                            class="w-full px-4 py-3 rounded-lg border border-border-standard dark:border-border-standard-dark bg-bg-surface dark:bg-bg-surface-dark text-text-primary dark:text-text-strong-dark focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 outline-none transition-all"
                            placeholder="Business, charity or organisation"
                        >
                    </div>

                    <div>
                        <label for="subject" class="block text-sm font-semibold text-text-primary dark:text-text-strong-dark mb-2">What would you like to discuss? *</label>
                        <select 
                            id="subject" 
                            name="subject" 
                            required 
                            class="w-full px-4 py-3 rounded-lg border border-border-standard dark:border-border-standard-dark bg-bg-surface dark:bg-bg-surface-dark text-text-primary dark:text-text-strong-dark focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 outline-none transition-all"
                        >
                            <option value="">Select a subject...</option>
                            <option value="new-project">New website project</option>
                            <option value="essentials">Essentials website subscription</option>
                            <option value="growth">Growth website subscription</option>
                            <option value="one-off">One-off website build</option>
                            <option value="charity">Charity or non-profit website</option>
                            <option value="general">General enquiry</option>
                        </select>
                    </div>

                    <div>
                        <label for="message" class="block text-sm font-semibold text-text-primary dark:text-text-strong-dark mb-2">Message *</label>
                        <textarea 
                            id="message" 
                            name="message" 
                            required 
                            maxlength="3000"
                            rows="6" 
                            class="w-full px-4 py-3 rounded-lg border border-border-standard dark:border-border-standard-dark bg-bg-surface dark:bg-bg-surface-dark text-text-primary dark:text-text-strong-dark focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 outline-none transition-all resize-vertical"
                            placeholder="What does your business do, and what would you like the website to improve?"
                        ></textarea>
                        <p class="mt-1 text-xs text-text-light text-right" id="message-counter">0 / 3000 characters</p>
                    </div>

                    <div class="flex items-start gap-3">
                        <input 
                            type="checkbox" 
                            id="privacy" 
                            name="privacy" 
                            required 
                            class="mt-1 w-4 h-4 text-brand-primary border-border-standard dark:border-border-standard-dark rounded focus:ring-brand-primary"
                        >
                        <label for="privacy" class="text-sm text-text-secondary dark:text-text-secondary-dark">
                            I agree to the <a href="/privacy-policy/" class="text-brand-primary dark:text-brand-primary-on-dark hover:underline">Privacy Policy</a> and understand my data will be processed to respond to this enquiry.
                        </label>
                    </div>

                    <button 
                        type="submit" 
                        class="btn btn--primary btn-shine w-full text-lg py-4"
                    >
                        Send your enquiry
                    </button>

                    <div id="form-message" class="hidden p-4 rounded-lg text-center"></div>
                </form>
            </div>
        </div>
    </div>
</section>

<script>
// Contact form handling for Netlify Forms
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('contact-form');
    const formMessage = document.getElementById('form-message');
    const messageField = document.getElementById('message');
    const messageCounter = document.getElementById('message-counter');

    // Character counter for message field
    if (messageField && messageCounter) {
        function updateCounter() {
            const length = messageField.value.length;
            const maxLength = messageField.maxLength;
            messageCounter.textContent = `${length} / ${maxLength} characters`;
            
            // Change colour when approaching limit
            if (length > maxLength * 0.9) {
                messageCounter.classList.add('text-red-600', 'dark:text-red-400');
                messageCounter.classList.remove('text-text-light');
            } else {
                messageCounter.classList.remove('text-red-600', 'dark:text-red-400');
                messageCounter.classList.add('text-text-light');
            }
        }
        
        messageField.addEventListener('input', updateCounter);
        updateCounter(); // Initial count
    }

    // Client-side validation for all fields
    function validateField(field) {
        const maxLength = parseInt(field.getAttribute('maxlength'));
        if (maxLength && field.value.length > maxLength) {
            field.setCustomValidity(`This field cannot exceed ${maxLength} characters.`);
            return false;
        }
        field.setCustomValidity('');
        return true;
    }

    // Validate all fields on input
    if (form) {
        const textFields = form.querySelectorAll('input[type="text"], input[type="email"], input[type="tel"], textarea');
        textFields.forEach(field => {
            field.addEventListener('input', function() {
                validateField(this);
            });
        });

        form.addEventListener('submit', async function(e) {
            e.preventDefault();

            // Validate all fields before submission
            let isValid = true;
            textFields.forEach(field => {
                if (!validateField(field)) {
                    isValid = false;
                }
            });

            if (!isValid) {
                formMessage.className = 'p-4 rounded-lg text-center bg-yellow-50 dark:bg-yellow-900/20 text-yellow-700 dark:text-yellow-400 border border-yellow-200 dark:border-yellow-800';
                formMessage.innerHTML = 'Please check your input. Some fields exceed the maximum length.';
                formMessage.classList.remove('hidden');
                return;
            }

            // Get form data
            const formData = new FormData(form);

            // Show loading state
            const submitButton = form.querySelector('button[type="submit"]');
            const originalButtonText = submitButton.innerHTML;
            submitButton.disabled = true;
            submitButton.innerHTML = 'Sending...';
            formMessage.classList.add('hidden');

            try {
                // Submit to Netlify Forms
                const response = await fetch('/', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams(formData).toString()
                });

                if (response.ok) {
                    // Success - redirect to thank you page
                    window.location.href = '/thank-you/';
                } else {
                    throw new Error('Form submission failed');
                }
            } catch (error) {
                // Error - show fallback message
                formMessage.className = 'p-4 rounded-lg text-center bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-400 border border-red-200 dark:border-red-800';
                formMessage.innerHTML = 'Sorry, there was an error sending your message. Please email me directly at <a href="mailto:hello@codecraftnorth.co.uk" class="underline font-semibold">hello@codecraftnorth.co.uk</a>';
                formMessage.classList.remove('hidden');
            } finally {
                // Reset button
                submitButton.disabled = false;
                submitButton.innerHTML = originalButtonText;
            }
        });
    }
});
</script>

