<section class="contact-hero bg-bg-primary dark:bg-bg-primary-dark">
    <div class="container py-12 md:py-16">
        <div class="grid lg:grid-cols-[0.85fr_1.15fr] gap-10 lg:gap-16 items-start">
            <div class="hero-entry lg:sticky lg:top-28">
                <p class="eyebrow">Free, practical second opinion</p>
                <h1 class="text-4xl sm:text-5xl md:text-6xl font-black mb-6 text-text-primary dark:text-text-strong-dark leading-[1.02]">Is your website helping—or quietly getting in the way?</h1>
                <p class="text-lg text-text-secondary dark:text-text-secondary-dark leading-relaxed mb-6">Send me the address and I will review the parts most likely to affect understanding, confidence and usability. You will receive a short, plain-English response within 48 hours.</p>
                <p class="plan-notice"><strong>This is not a disguised sales call.</strong> If the website is doing its job, I will say so. If something stands out, I will explain the most useful next step.</p>

                <div class="hidden lg:grid grid-cols-2 gap-4 mt-8">
                    <article class="decision-card"><h3>What I look at</h3><p>Clarity, calls to action, trust signals, mobile usability, accessibility basics and obvious performance concerns.</p></article>
                    <article class="decision-card"><h3>What you receive</h3><p>A focused response with useful observations and priorities—not a lengthy automated report full of unexplained scores.</p></article>
                </div>

                <p class="hidden lg:block mt-6 text-sm text-text-secondary dark:text-text-secondary-dark">A review is a high-level assessment, not a full accessibility, SEO, security or technical audit.</p>
            </div>

            <div class="bg-bg-surface dark:bg-bg-surface-dark rounded-xl p-6 md:p-8 shadow-lg border border-border-standard dark:border-border-standard-dark">
                <p class="eyebrow">Usually takes two minutes</p>
                <h2 class="text-3xl font-black mb-3 text-text-primary dark:text-text-strong-dark">Request your free review</h2>
                <p class="text-text-secondary dark:text-text-secondary-dark mb-8 leading-relaxed">Three details are required. Add context only if there is something specific you want me to consider.</p>

                <form id="website-review-form" name="website-review" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="space-y-6">
                    <input type="hidden" name="form-name" value="website-review">
                    <p class="hidden"><label>Don’t fill this out if you’re human: <input name="bot-field" maxlength="50"></label></p>

                    <div>
                        <label for="review-name" class="block text-sm font-semibold text-text-primary dark:text-text-strong-dark mb-2">Your name *</label>
                        <input type="text" id="review-name" name="name" required maxlength="100" autocomplete="name" class="w-full px-4 py-3 rounded-lg border border-border-standard dark:border-border-standard-dark bg-bg-surface dark:bg-bg-surface-dark text-text-primary dark:text-text-strong-dark focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 outline-none transition-all" placeholder="Your name">
                    </div>

                    <div>
                        <label for="review-email" class="block text-sm font-semibold text-text-primary dark:text-text-strong-dark mb-2">Email address *</label>
                        <input type="email" id="review-email" name="email" required maxlength="254" autocomplete="email" class="w-full px-4 py-3 rounded-lg border border-border-standard dark:border-border-standard-dark bg-bg-surface dark:bg-bg-surface-dark text-text-primary dark:text-text-strong-dark focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 outline-none transition-all" placeholder="you@example.com">
                    </div>

                    <div>
                        <label for="review-website" class="block text-sm font-semibold text-text-primary dark:text-text-strong-dark mb-2">Website address *</label>
                        <input type="text" id="review-website" name="website_url" required maxlength="500" autocomplete="url" inputmode="url" aria-describedby="review-website-hint review-website-error" class="w-full px-4 py-3 rounded-lg border border-border-standard dark:border-border-standard-dark bg-bg-surface dark:bg-bg-surface-dark text-text-primary dark:text-text-strong-dark focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 outline-none transition-all" placeholder="yourwebsite.co.uk">
                        <p id="review-website-hint" class="mt-2 text-xs text-text-secondary dark:text-text-secondary-dark">With or without https:// is fine.</p>
                        <p id="review-website-error" class="mt-2 text-sm text-red-600 dark:text-red-400 hidden" role="alert">Please enter a valid website address, such as yourwebsite.co.uk.</p>
                    </div>

                    <div>
                        <label for="review-organisation" class="block text-sm font-semibold text-text-primary dark:text-text-strong-dark mb-2">Organisation name <span class="font-normal text-text-secondary dark:text-text-secondary-dark">(optional)</span></label>
                        <input type="text" id="review-organisation" name="organisation" maxlength="150" autocomplete="organization" class="w-full px-4 py-3 rounded-lg border border-border-standard dark:border-border-standard-dark bg-bg-surface dark:bg-bg-surface-dark text-text-primary dark:text-text-strong-dark focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 outline-none transition-all" placeholder="Business, charity or organisation">
                    </div>

                    <div>
                        <label for="review-focus" class="block text-sm font-semibold text-text-primary dark:text-text-strong-dark mb-2">Anything specific to review? <span class="font-normal text-text-secondary dark:text-text-secondary-dark">(optional)</span></label>
                        <textarea id="review-focus" name="focus" maxlength="1000" rows="4" class="w-full px-4 py-3 rounded-lg border border-border-standard dark:border-border-standard-dark bg-bg-surface dark:bg-bg-surface-dark text-text-primary dark:text-text-strong-dark focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 outline-none transition-all resize-vertical" placeholder="For example: people struggle to find the right service..."></textarea>
                        <p class="mt-1 text-xs text-text-light text-right" id="review-focus-counter">0 / 1000 characters</p>
                    </div>

                    <button type="submit" class="btn btn--primary btn-shine justify-center w-full text-lg py-4">Request my free review</button>
                    <p class="text-xs text-text-secondary dark:text-text-secondary-dark leading-relaxed text-center">I will only use these details to prepare your review and respond to you. See the <a href="/privacy-policy/" class="text-link">Privacy Policy</a>.</p>
                    <div id="review-form-message" class="hidden p-4 rounded-lg text-center" role="alert" aria-live="assertive"></div>
                </form>
            </div>
        </div>
    </div>
</section>

<section class="section-padding bg-bg-section dark:bg-bg-section-dark">
    <div class="container">
        <div class="section-intro"><p class="eyebrow">What happens next</p><h2>A useful response, without the awkward follow-up</h2></div>
        <ol class="grid grid-cols-1 md:grid-cols-3 gap-6 process-list max-w-5xl mx-auto">
            <li><span>01</span><h3>You send the website</h3><p>Share the address and any concern you already have. No lengthy brief is required.</p></li>
            <li><span>02</span><h3>I review it personally</h3><p>I look through the key pages on desktop and mobile and note the most useful observations.</p></li>
            <li><span>03</span><h3>You decide what to do</h3><p>Use the advice yourself, ask your existing provider or talk to me. There is no obligation.</p></li>
        </ol>
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('website-review-form');
    const formMessage = document.getElementById('review-form-message');
    const focusField = document.getElementById('review-focus');
    const focusCounter = document.getElementById('review-focus-counter');

    if (focusField && focusCounter) {
        function updateFocusCounter() {
            const length = focusField.value.length;
            focusCounter.textContent = length + ' / 1000 characters';
            focusCounter.classList.toggle('text-red-600', length > 900);
            focusCounter.classList.toggle('dark:text-red-400', length > 900);
        }
        focusField.addEventListener('input', updateFocusCounter);
        updateFocusCounter();
    }

    if (form) {
        const websiteInput = document.getElementById('review-website');
        const websiteError = document.getElementById('review-website-error');

        function normaliseWebsiteUrl(value) {
            const trimmed = (value || '').trim();
            if (!trimmed) return '';
            return /^https?:\/\//i.test(trimmed) ? trimmed : 'https://' + trimmed;
        }

        function isValidWebsiteUrl(value) {
            try {
                const url = new URL(value);
                return ['http:', 'https:'].includes(url.protocol) && (url.hostname === 'localhost' || url.hostname.includes('.'));
            } catch {
                return false;
            }
        }

        form.addEventListener('submit', async function(e) {
            e.preventDefault();
            const normalised = normaliseWebsiteUrl(websiteInput.value);
            websiteError.classList.add('hidden');
            websiteInput.setAttribute('aria-invalid', 'false');

            if (!normalised || !isValidWebsiteUrl(normalised)) {
                websiteError.classList.remove('hidden');
                websiteInput.setAttribute('aria-invalid', 'true');
                websiteInput.focus();
                return;
            }
            websiteInput.value = normalised;

            const submitButton = form.querySelector('button[type="submit"]');
            const originalText = submitButton.textContent;
            submitButton.disabled = true;
            submitButton.textContent = 'Sending...';
            formMessage.classList.add('hidden');

            try {
                const response = await fetch('/', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams(new FormData(form)).toString()
                });
                if (!response.ok) throw new Error('Form submission failed');
                window.location.href = '/website-review-thanks/';
            } catch (error) {
                formMessage.className = 'p-4 rounded-lg text-center bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-400 border border-red-200 dark:border-red-800';
                formMessage.innerHTML = 'Sorry, there was an error sending your request. Please try again or email <a href="mailto:hello@codecraftnorth.co.uk" class="underline font-semibold">hello@codecraftnorth.co.uk</a>.';
                formMessage.classList.remove('hidden');
            } finally {
                submitButton.disabled = false;
                submitButton.textContent = originalText;
            }
        });
    }
});
</script>

